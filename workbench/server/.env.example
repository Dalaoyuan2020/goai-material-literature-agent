# 服务监听地址，默认 0.0.0.0，便于部署到局域网或容器
HOST=0.0.0.0
PORT=8787

# 前后端对接密钥，生产环境必须修改
API_KEY=dev-key-change-me

# 允许的前端来源，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 前端可读取的后端地址
BACKEND_BASE_URL=http://localhost:8787/api/v1

# 材料文献智能体仓库根目录；留空自动使用 workbench/ 的父目录
MATERIAL_AGENT_ROOT=

# Python 解释器；留空时 Windows 使用 python，其他平台使用 python3
PYTHON_BIN=

# 导出文件和报告输出目录；留空使用项目 outputs/workbench
OUTPUT_DIR=
